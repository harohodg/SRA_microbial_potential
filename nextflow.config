conda.enabled       = true 
conda.cacheDir      = "${projectDir}/.nextflow_conda_cache"
conda.createOptions = '-c conda-forge'

dag.overwrite       = true
trace.overwrite     = true
report.overwrite    = true
timeline.overwrite  = true

process {
        executor  = 'local'
        queueSize = 0
        withLabel: 'serial_job' { cpus = 1 }
        withLabel: 'small_job'  { cpus = 2 }
        withLabel: 'medium_job' { cpus = 4 }
        withLabel: 'large_job'  { cpus = 8 }
}

profiles {

    testing {
        process.executor = 'local'
        process.cpus     = 1
    }


    FLUX {
        process {
            flux.terminalOutput = true
            executor  = 'flux'
            withName: 'DOWNLOAD_LOGAN_DATA|PREFETCH_SRA_DATASET|EXTRACT_SRA_DATASET|CALCULATE_NUM_SPOTS' {clusterOptions = '--urgency=25'}
            withName: 'MAP_TO_REFERENCE_AND_EXTRACT_READS' {clusterOptions = '--urgency=26'}
            withName: 'DOWNLOAD_REFERENCE_GENOME|INDEX_REFERENCE' {clusterOptions = '--urgency=27'}
            withName: 'MEGAHIT' {clusterOptions = '--urgency=28'}
            withName: 'SKANI_LABEL_CONTIGS|FILTER_CONTIG_LABELS|EXTRACT_CONTIGS|SIZE_FILTER_CONTIGS' {clusterOptions = '--urgency=29'}
            withName: 'GLOBAL_ANI' {clusterOptions = '--urgency=30'}
            withName: 'CHECKM2|FETCH_CHECKM_DATABASE' {clusterOptions = '--urgency=31'}
        }
    }
}